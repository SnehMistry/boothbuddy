# Copy this file to .env and fill in real values. Never commit .env.
#
# These are the only keys that belong in the app itself — they are
# "public" client keys (safe to ship in a compiled app / bundle).
# AI provider keys (OpenAI, Anthropic) are NOT listed here: they live
# only in Supabase Edge Function secrets, set with `supabase secrets set`,
# and are never exposed to the client. See supabase/functions/README.md
# once Phase 3 adds it.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
