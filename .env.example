# Copy this file to .env and fill in real values. Never commit .env.
#
# These are the only keys that belong in the app itself — they are
# "public" client keys (safe to ship in a compiled app / bundle).
# The Gemini API key (GEMINI_API_KEY) is NOT listed here: it lives only
# as a Supabase Edge Function secret (already set with
# `supabase secrets set GEMINI_API_KEY=...`) and is never exposed to the
# client. See supabase/functions/README.md once Phase 3 adds it.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
